# Copy to backend.tf before a production apply.
# GitHub Actions does not copy this file; CI uses `terraform init -backend=false`
# so plan/validate can run without AWS credentials or a state bucket.
terraform {
  backend "s3" {
    bucket  = "rca-agent-tfstate"
    key     = "deploy/terraform.tfstate"
    region  = "us-east-1"
    encrypt = true
  }
}
