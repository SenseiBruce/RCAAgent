# Copy to .env and fill in values. Tests and Docker (fake provider) do not need real keys.

# LLM: fake | openrouter | openai | bedrock
LLM_PROVIDER=fake

# OpenRouter (when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI (when LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_BASE_URL=https://api.openai.com/v1

# AWS Bedrock (when LLM_PROVIDER=bedrock)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# Optional overrides
LLM_MAX_TOKENS=16384
GIT_DEFAULT_BRANCH=main
GIT_MAX_COMMITS=50
GIT_REPO_URL=
LOG_MAX_FILE_SIZE_MB=100
LOG_LEVEL=INFO

# Optional: absolute path to a custom RCA prompt file
# RCA_PROMPT_PATH=/absolute/path/to/rca-analysis.txt

# Required only for auto-fix pull requests (never commit a real token)
GITHUB_TOKEN=your-github-token

# Vite UI: proxy target for local `npm run dev` (docker-compose overrides this)
VITE_API_PROXY=http://localhost:8080
